# Select google, anthropic, openai, or openai-compatible in the shell or service environment.
# Seb ignores this selector when the automatic current-directory .env loader adds it.
# Seb can discover one hosted provider when this value is empty.
SEB_MODEL_PROVIDER=

# Add the key for each hosted provider that you use.
# GEMINI_API_KEY is also accepted as a Google key alias.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# An OpenAI-compatible endpoint needs a base URL and model.
# Its key is optional. HTTP is allowed only for a loopback host.
# Set its selector and base URL in the shell, service environment, or seb configure.
# The automatic current-directory .env loader ignores the selector and base URL.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_FALLBACK_MODEL=

# These shell or service values override the provider-specific model variables below.
# The automatic current-directory .env loader ignores SEB_MODEL.
# SEB_MODEL keeps the configured fallback unless SEB_FALLBACK_MODEL overrides it.
# Only a CLI --model value or interactive /model value disables fallback by default.
SEB_MODEL=
SEB_FALLBACK_MODEL=

# Model families select the newest stable version. Exact IDs stay pinned.
GEMINI_MODEL=gemini-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite
ANTHROPIC_MODEL=claude-sonnet
ANTHROPIC_FALLBACK_MODEL=claude-haiku
OPENAI_MODEL=gpt-luna
OPENAI_FALLBACK_MODEL=gpt-mini

# The connector service reads provider settings only from its environment.
# The interactive `seb configure` command uses private local files instead.

# Record AI SDK runs locally for development. Never enable this in production.
SEB_DEVTOOLS=false

# NWS requests must identify this application. Add your email or project URL.
NWS_USER_AGENT=seb/1.0.1 (https://github.com/arvarik/seb)

# Optional Sleeper username for the first preferences file.
SEB_SLEEPER_USER=

# Optional preferences locations. Do not set both values.
# SEB_PROFILE_FILE selects the complete preferences file path.
# SEB_CONFIG_HOME selects a directory that contains profile.json.
SEB_PROFILE_FILE=
SEB_CONFIG_HOME=

# Optional complete path for the non-secret model settings file.
SEB_MODEL_SETTINGS_FILE=

# Optional terminal settings.
# The theme can be default, high-contrast, or compact.
# The icon set can be unicode or ascii.
SEB_THEME=default
SEB_ICONS=unicode

# Seb saves up to 200 recent prompts in a private local file.
# Set SEB_HISTORY=false to keep history only in memory.
SEB_HISTORY=true
SEB_HISTORY_FILE=

# Start one or more connectors. Separate multiple names with commas.
# Supported values are slack, discord, and telegram.
SEB_CONNECTORS=
SEB_BOT_NAME=seb
HOST=0.0.0.0
PORT=3000

# Slack webhook mode needs the bot token and the signing secret.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Slack Socket Mode replaces the public Slack webhook during local use.
SEB_SLACK_MODE=webhook
SLACK_APP_TOKEN=

# Discord needs all three values. The Gateway receives messages and mentions.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
SEB_DISCORD_GATEWAY=true

# Telegram can use polling locally. Webhook mode requires a secret after deployment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
SEB_TELEGRAM_MODE=auto
TELEGRAM_ALLOWED_USER_IDS=

# Production connector deployments need shared, persistent state.
REDIS_URL=
