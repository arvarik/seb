{
  "name": "seb",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "description": "A source-grounded NFL and fantasy football agent for league, player, team, weather, and news analysis.",
  "bin": {
    "seb": "bin/seb.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ask": "node --import tsx src/cli.ts ask",
    "check": "npm run version:check && npm run lint && npm run typecheck && npm test",
    "connectors": "node --import tsx src/connectors/server.ts",
    "deps:check": "npm outdated",
    "devtools": "devtools",
    "data:smoke": "node --import tsx src/smoke-data-sources.ts",
    "doctor": "node --import tsx src/cli.ts doctor",
    "lint": "oxlint --deny-warnings src test scripts",
    "seb": "node --import tsx src/cli.ts",
    "sleeper:smoke": "node --import tsx src/smoke-sleeper.ts",
    "start": "npm run seb",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:connectors": "vitest run test/connectors.test.ts",
    "test:harness": "vitest run test/agent-harness.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version:check": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.48",
    "@ai-sdk/tui": "1.0.72",
    "@chat-adapter/discord": "^4.38.1",
    "@chat-adapter/slack": "^4.38.1",
    "@chat-adapter/state-memory": "^4.38.1",
    "@chat-adapter/state-redis": "^4.38.1",
    "@chat-adapter/telegram": "^4.38.1",
    "@hono/node-server": "^2.1.1",
    "ai": "^7.0.71",
    "better-sqlite3": "^13.0.3",
    "chat": "^4.38.1",
    "csv-parse": "^7.0.2",
    "hono": "^4.13.3",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^1.0.12",
    "@chat-adapter/tests": "^4.38.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
