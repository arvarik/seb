{
  "name": "@arvarik/seb",
  "version": "1.1.2",
  "private": false,
  "type": "module",
  "description": "A source-grounded NFL and fantasy football agent for league, player, team, weather, and news analysis.",
  "bin": {
    "seb": "bin/seb.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ask": "node --import tsx src/cli.ts ask",
    "check": "npm run version:check && npm run lint && npm run typecheck && npm test",
    "connectors": "node --import tsx src/connectors/server.ts",
    "contract:answer": "node --import tsx src/smoke-answer-contract.ts",
    "contract:sources": "node --import tsx src/smoke-data-sources.ts",
    "deps:check": "npm outdated",
    "devtools": "devtools",
    "data:smoke": "node --import tsx src/smoke-data-sources.ts",
    "doctor": "node --import tsx src/cli.ts doctor",
    "lint": "oxlint --deny-warnings src test scripts",
    "news:smoke": "node --import tsx src/smoke-news-sources.ts",
    "seb": "node --import tsx src/cli.ts",
    "sleeper:smoke": "node --import tsx src/smoke-sleeper.ts",
    "start": "npm run seb",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:connectors": "vitest run test/connectors.test.ts",
    "test:harness": "vitest run test/agent-harness.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version:check": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.91",
    "@ai-sdk/google": "^4.0.107",
    "@ai-sdk/openai": "^4.0.104",
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@ai-sdk/otel": "^1.0.156",
    "@chat-adapter/discord": "^4.43.0",
    "@chat-adapter/slack": "^4.43.0",
    "@chat-adapter/state-memory": "^4.43.0",
    "@chat-adapter/state-redis": "^4.43.0",
    "@chat-adapter/telegram": "^4.43.0",
    "@hono/node-server": "^2.1.5",
    "ai": "^7.0.156",
    "better-sqlite3": "^13.0.3",
    "chat": "^4.43.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "hono": "^4.13.14",
    "judgeval": "^1.5.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^1.0.59",
    "@chat-adapter/tests": "^4.43.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvarik/seb.git"
  },
  "homepage": "https://github.com/arvarik/seb#readme",
  "bugs": {
    "url": "https://github.com/arvarik/seb/issues"
  },
  "keywords": [
    "cli",
    "nfl",
    "fantasy-football",
    "sleeper",
    "ai-agent"
  ],
  "author": "Arvind Arikatla",
  "files": [
    "bin/",
    "src/",
    "scripts/check-version.mjs",
    "docs/",
    "CHANGELOG.md",
    ".env.example"
  ]
}
